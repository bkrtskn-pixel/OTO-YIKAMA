# API geliştirme ortamı. Bu dosyayı .env olarak kopyalayın.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# PostgreSQL bağlantısı (yerel kurulum veya docker compose)
DATABASE_URL=postgresql://kuzhan:kuzhan_dev@localhost:5432/kuzhan?schema=public

# Entegrasyon gizli bilgilerini şifrelemek için 32 baytlık anahtar (base64).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Uygulamanın dışarıdan erişilen adresi (takip/anket linkleri için)
PUBLIC_BASE_URL=http://localhost:3000

# Sentry DSN (boş bırakılırsa hata takibi kapalı)
SENTRY_DSN=
